# Optional: talk to FastAPI directly (skips Next proxy). Example if API is on 8000:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Where Next.js proxies /api/backend/* (default in next.config is http://127.0.0.1:8080)
# BACKEND_URL=http://127.0.0.1:8080

# WebSocket must match your real API port (default in app is ws://127.0.0.1:8080)
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080
