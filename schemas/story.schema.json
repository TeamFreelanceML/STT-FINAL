{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guided-reading.local/schemas/story.schema.json",
  "title": "GuidedReadingStory",
  "type": "object",
  "required": ["paragraphs"],
  "properties": {
    "title": { "type": "string" },
    "paragraphs": {
      "type": "array",
      "items": { "$ref": "#/$defs/paragraph" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "chunk": {
      "type": "object",
      "required": ["words"],
      "properties": {
        "words": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "sentence": {
      "type": "object",
      "required": ["chunks"],
      "properties": {
        "chunks": {
          "type": "array",
          "items": { "$ref": "#/$defs/chunk" }
        }
      },
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "required": ["sentences"],
      "properties": {
        "sentences": {
          "type": "array",
          "items": { "$ref": "#/$defs/sentence" }
        }
      },
      "additionalProperties": false
    }
  }
}
